@page "/admin/products/new"
@page "/admin/products/{Id:int}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
@layout AdminLayout
@using DeluxeDecor.Services
@inject CatalogService Catalog
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(Id == 0 ? "منتج جديد" : "تعديل منتج")</PageTitle>

@if (notFound)
{
    <p class="alert">المنتج غير موجود.</p>
    <a class="btn" href="/admin/products">العودة للمنتجات</a>
}
else if (model is null)
{
    <p class="muted">جارٍ التحميل…</p>
}
else
{
    <div class="page-head">
        <h1>@(Id == 0 ? "منتج جديد" : "تعديل منتج")</h1>
    </div>

    @if (categories.Count == 0)
    {
        <p class="alert">لازم تضيفي فئة أولًا قبل إضافة منتج.</p>
    }

    @if (error is not null)
    {
        <div class="alert">@error</div>
    }

    <EditForm Model="model" OnSubmit="SaveAsync">
        <section class="panel">
            <h2>بيانات المنتج</h2>
            <div class="form-row">
                <label>الفئة
                    <InputSelect @bind-Value="model.CategoryId">
                        <option value="0">— اختاري —</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </InputSelect>
                </label>
                <label>الترتيب (الأصغر أولًا)
                    <InputNumber @bind-Value="model.SortOrder" />
                </label>
                <label class="check">
                    <InputCheckbox @bind-Value="model.IsActive" /> ظاهر في الموقع
                </label>
            </div>
            <label>الرابط (Slug) — اختياري، بيتولّد تلقائيًا
                <InputText @bind-Value="model.Slug" dir="ltr" placeholder="emerald-capsule-mirror" />
            </label>
        </section>

        <section class="panel">
            <h2>الاسم والوصف بكل لغة</h2>

            <div class="tabs">
                @foreach (var l in Languages.All)
                {
                    <button type="button" class="tab @(l.Code == activeLang ? "active" : "")" @onclick="() => activeLang = l.Code">
                        @l.Name @(Filled(l.Code) ? "✓" : "")
                    </button>
                }
            </div>

            @foreach (var tr in model.Translations)
            {
                if (tr.LanguageCode == activeLang)
                {
                    <label>الاسم
                        <InputText @bind-Value="tr.Name" dir="@Languages.Dir(tr.LanguageCode)" />
                    </label>
                    <label>الوصف
                        <InputTextArea @bind-Value="tr.Description" rows="6" dir="@Languages.Dir(tr.LanguageCode)" />
                    </label>
                }
            }

            <p class="hint">إذا تركتي لغة فاضية، الموقع بيعرض النسخة الإنجليزية (أو أول لغة متوفرة).</p>
        </section>

        <section class="panel">
            <h2>الصورة المصغّرة (تظهر على كرت المنتج)</h2>

            @if (thumbFile is not null)
            {
                <p>رح تنرفع: <span dir="ltr">@thumbFile.Name</span>
                    <button type="button" class="link" @onclick="() => thumbFile = null">إزالة</button></p>
            }
            else if (model.ThumbnailFileName is not null)
            {
                <div class="thumb-row">
                    <img class="thumb-big" src="@($"/uploads/{model.ThumbnailFileName}")" alt="" />
                    <button type="button" class="btn btn-sm btn-danger" @onclick="ClearThumbAsync">حذف المصغّرة</button>
                </div>
            }

            <label>اختاري صورة مصغّرة (JPG / PNG / WebP، حتى 8MB)
                <InputFile OnChange="OnThumb" accept=".jpg,.jpeg,.png,.webp" />
            </label>
            <p class="hint">إذا ما رفعتي مصغّرة، الكرت بيستخدم أول صورة من صور التفاصيل.</p>
        </section>

        <section class="panel">
            <h2>صور وفيديو صفحة التفاصيل (حجم أكبر)</h2>

            @if (model.Images.Count > 0)
            {
                <div class="thumbs">
                    @for (var i = 0; i < model.Images.Count; i++)
                    {
                        var img = model.Images[i];
                        <figure>
                            @if (ImageStorage.IsVideo(img.FileName))
                            {
                                <video src="@($"/uploads/{img.FileName}")" muted preload="metadata"></video>
                            }
                            else
                            {
                                <img src="@($"/uploads/{img.FileName}")" alt="" />
                            }
                            @if (i == 0) { <span class="badge">الرئيسية</span> }
                            <figcaption>
                                @if (i != 0)
                                {
                                    <button type="button" class="btn btn-sm" @onclick="() => MakeCoverAsync(img)">اجعليها الرئيسية</button>
                                }
                                <label class="btn btn-sm replace-btn">استبدال
                               <InputFile OnChange="e => ReplaceAsync(img, e)" accept=".jpg,.jpeg,.png,.webp,.mp4,.webm" />
                                  </label> 
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteImageAsync(img)">حذف</button>
                            </figcaption>
                        </figure>
                    }
                </div>
            }

            <label>إضافة ملفات (صور JPG / PNG / WebP حتى 8MB، أو فيديو MP4 / WebM حتى 50MB)
                <InputFile OnChange="OnFiles" multiple accept=".jpg,.jpeg,.png,.webp,.mp4,.webm" />
            </label>

            @if (pending.Count > 0)
            {
                <ul class="pending">
                    @foreach (var f in pending)
                    {
                        <li>
                            <span dir="ltr">@f.Name</span> <span class="muted">(@(f.Size / 1024) KB)</span>
                            <button type="button" class="link" @onclick="() => pending.Remove(f)">إزالة</button>
                        </li>
                    }
                </ul>
                <p class="hint">رح تنرفع هاي الملفات لما تضغطي «حفظ». الفيديو الكبير ممكن ياخد وقت.</p>
            }
            <p class="hint">أول ملف هو اللي بيظهر كبير بأول صفحة المنتج.</p>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(saving || categories.Count == 0)">@(saving ? "جارٍ الحفظ…" : "حفظ")</button>
            <a class="btn" href="/admin/products">إلغاء</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductEditModel? model;
    private List<CategoryVm> categories = new();
    private readonly List<IBrowserFile> pending = new();
    private IBrowserFile? thumbFile;
    private string activeLang = Languages.Default;
    private string? error;
    private bool saving;
    private bool notFound;
    private int? loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id) return;
        loadedId = Id;

        notFound = false;
        error = null;
        pending.Clear();
        thumbFile = null;
        categories = await Catalog.GetCategoriesAsync("ar");

        if (Id == 0)
        {
            model = new ProductEditModel { CategoryId = categories.FirstOrDefault()?.Id ?? 0 };
        }
        else
        {
            model = await Catalog.GetProductEditModelAsync(Id);
            notFound = model is null;
        }
    }

    private bool Filled(string code) =>
        model!.Translations.Any(t => t.LanguageCode == code && !string.IsNullOrWhiteSpace(t.Name));

    private void OnThumb(InputFileChangeEventArgs e)
    {
        error = null;
        var f = e.File;
        var ext = Path.GetExtension(f.Name).ToLowerInvariant();
        if (!ImageStorage.ImageExtensions.Contains(ext))
        {
            error = $"«{f.Name}»: الصورة المصغّرة لازم تكون JPG أو PNG أو WebP.";
            return;
        }
        if (f.Size > ImageStorage.MaxImageBytes)
        {
            error = $"«{f.Name}»: حجم الصورة أكبر من 8MB.";
            return;
        }
        thumbFile = f;
    }

    private void OnFiles(InputFileChangeEventArgs e)
    {
        error = null;
        foreach (var f in e.GetMultipleFiles(20))
        {
            var ext = Path.GetExtension(f.Name).ToLowerInvariant();
            if (!ImageStorage.AllowedExtensions.Contains(ext))
            {
                error = $"«{f.Name}»: النوع غير مدعوم (صور JPG / PNG / WebP أو فيديو MP4 / WebM).";
                continue;
            }
            if (f.Size > ImageStorage.LimitFor(f.Name))
            {
                error = ImageStorage.IsVideo(f.Name)
                    ? $"«{f.Name}»: حجم الفيديو أكبر من 50MB."
                    : $"«{f.Name}»: حجم الصورة أكبر من 8MB.";
                continue;
            }
            pending.Add(f);
        }
    }

    private async Task SaveAsync()
    {
        error = null;
        saving = true;
        try
        {
            await Catalog.SaveProductAsync(model!, pending, thumbFile);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            saving = false;
            return;
        }
        saving = false;
        Nav.NavigateTo("/admin/products");
    }

    private async Task ClearThumbAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حذف الصورة المصغّرة؟")) return;
        await Catalog.ClearThumbnailAsync(model!.Id);
        model.ThumbnailFileName = null;
    }

    private async Task MakeCoverAsync(ImageVm img)
    {
        await Catalog.SetCoverAsync(model!.Id, img.Id);
        await ReloadImagesAsync();
    }

    private async Task DeleteImageAsync(ImageVm img)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حذف هاد الملف نهائيًا؟")) return;
        await Catalog.DeleteImageAsync(img.Id);
        await ReloadImagesAsync();
    }

    private async Task ReloadImagesAsync()
    {
        var fresh = await Catalog.GetProductEditModelAsync(model!.Id);
        if (fresh is not null) model.Images = fresh.Images;
    }

private async Task ReplaceAsync(ImageVm img, InputFileChangeEventArgs e)
{
    error = null;
    var f = e.File;
    var ext = Path.GetExtension(f.Name).ToLowerInvariant();

    if (!ImageStorage.AllowedExtensions.Contains(ext))
    {
        error = $"«{f.Name}»: النوع غير مدعوم.";
        return;
    }
    if (f.Size > ImageStorage.LimitFor(f.Name))
    {
        error = $"«{f.Name}»: الحجم أكبر من المسموح.";
        return;
    }

    try
    {
        await Catalog.ReplaceImageAsync(img.Id, f);
        await ReloadImagesAsync();
    }
    catch (Exception ex)
    {
        error = ex.Message;
    }
}


}