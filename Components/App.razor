@using DeluxeDecor.Services
<!DOCTYPE html>
<html lang="@Lang" dir="@Dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
   <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="site.js"></script>
</body>

</html>
@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Lang => Languages.FromPath(Http?.Request.Path.Value);
    private string Dir => Languages.Dir(Lang);
}